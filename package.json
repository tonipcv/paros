    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.0",
    "stripe": "^17.5.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.1"
