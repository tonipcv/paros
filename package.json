    "test:billing-enforced": "node --import tsx tests/billing-enforced.test.ts",
    "test:security": "node --import tsx tests/security-invariants.test.ts",
    "test:e2ee": "node --import tsx tests/e2ee-seal.test.ts",
    "test:email": "node --import tsx tests/email-mailchannels.test.ts",
    "test:mcp": "node --import tsx tests/mcp-contract.test.ts",
    "test:catalog": "node --import tsx tests/model-catalog.test.ts",
    "test:multimodal": "node --import tsx tests/multimodal-contract.test.ts",
    "test:unit-economics": "node --import tsx tests/unit-economics.test.ts",
    "test:e2e:pricing": "node --import tsx tests/e2e-pricing-http.test.ts",
    "test:e2e:verify": "node --import tsx tests/e2e-email-verification.test.ts",
    "test:e2e:security": "node --import tsx tests/e2e-security-billing.test.ts",
    "test:stripe:sandbox": "node --import tsx tests/stripe-sandbox.test.ts",
    "test:stripe:webhook:local": "node --import tsx tests/stripe-webhook-local.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "stripe:webhook:create": "node scripts/create-stripe-webhook.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "mcp": "tsx src/mcp/server.ts"
